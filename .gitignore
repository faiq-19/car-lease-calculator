# .gitignore for Car Lease Calculator

# Operating System Files
.DS_Store
Thumbs.db
*.swp
*~

# Node.js & Dependencies (if any generated)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build and Distribution Output
dist/
build/
out/

# Environment and Local Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Test and Coverage Results
coverage/
.nyc_output/

# IDE and Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Note: .gemini/ and docs/ are intentional repository files containing project records.